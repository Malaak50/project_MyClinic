rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Users collection: 
    // - Users can read/write their own document
    // - Admins can read/write all user documents (needed for creating doctors/viewing patients)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin'));
      allow write: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin'));
    }

    // Patients collection:
    // - Patients can read/write their own profile
    // - Doctors can read patient profiles (for appointments/medical records)
    // - Admins can read all patient profiles
    match /patients/{patientId} {
      allow read: if isAuthenticated() && (request.auth.uid == patientId || hasRole('doctor') || hasRole('admin'));
      allow write: if isAuthenticated() && (request.auth.uid == patientId || hasRole('admin'));
    }

    // Doctors collection:
    // - Public read access (for finding doctors)
    // - Admins can write (create/update doctors)
    // - Doctors can update their own profile
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAuthenticated() && (hasRole('admin') || request.auth.uid == doctorId);
    }

    // Appointments collection:
    // - Patients can read/write their own appointments
    // - Doctors can read/write appointments where they are the doctor
    // - Admins can read/write all appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid || 
        hasRole('admin')
      );
      allow create: if isAuthenticated(); // Refined validation could be added here
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid || 
        hasRole('admin')
      );
    }

    // Medical Records collection:
    // - Patients can read their own records
    // - Doctors can read/write records they created or for their patients
    // - Admins can read/write all records
    match /medical_records/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasRole('doctor') || 
        hasRole('admin')
      );
      allow write: if isAuthenticated() && (hasRole('doctor') || hasRole('admin'));
    }

    // Prescriptions collection:
    // - Same rules as medical records
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        hasRole('doctor') || 
        hasRole('admin')
      );
      allow write: if isAuthenticated() && (hasRole('doctor') || hasRole('admin'));
    }

    // Notifications collection:
    // - Users can read notifications targeted to them or 'all' or their group
    // - Admins can write notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated(); // Filtering is done in query
      allow write: if hasRole('admin');
    }
  }
}
