' Diagramme de classes
@startuml
class User {
  +uid: string
  +name: string
  +email: string
  +role: Role
}
enum Role { patient, doctor, admin }

class Doctor {
  +id: string
  +name: string
  +clinicName: string
  +specialties: string[]
  +phone: string
  +status: string
  +availability: Availability[]
}
class Availability {
  +day: string
  +slots: string[]
}

class Patient {
  +id: string
  +name: string
  +email: string
}

class Appointment {
  +id: string // slotKey
  +doctorId: string
  +patientId: string
  +doctorName: string
  +clinicName: string
  +patientName: string
  +scheduledAt: Timestamp
  +status: string // pending|confirmed|cancelled|completed
  +reason: string
  +notes: string
  +createdAt: Timestamp
}

class Prescription {
  +id: string
  +patientId: string
  +doctorId: string
  +createdAt: Timestamp
  +content: string
}

class MedicalRecord {
  +id: string
  +patientId: string
  +doctorId: string
  +entries: string
  +updatedAt: Timestamp
}

User "1" -- "0..1" Patient : role=patient
User "1" -- "0..1" Doctor : role=doctor
Doctor "1" o-- "many" Availability
Doctor "1" -- "many" Appointment : doctorId
Patient "1" -- "many" Appointment : patientId
Doctor "1" -- "many" Prescription : doctorId
Patient "1" -- "many" Prescription : patientId
Doctor "1" -- "many" MedicalRecord : doctorId
Patient "1" -- "many" MedicalRecord : patientId
@enduml

